# Copy to .env and fill in. Never commit .env.

# ── Database ─────────────────────────────────────────────
# docker compose builds this for you. Set it only when running without Docker.
# DATABASE_URL=mysql://user:password@host:3306/mf_factsheet_bot
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ── Sign-in ──────────────────────────────────────────────
# LOCAL_MODE=true  -> no sign-in, PDFs on disk (laptop only)
# LOCAL_MODE=false -> email + password accounts (team server)
LOCAL_MODE=true
# AUTH_MODE=password
# First administrator, created automatically on first start:
# ADMIN_EMAIL=you@1finance.co.in
# ADMIN_PASSWORD=at-least-10-characters
# Random, 32+ characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Set to true when running behind an HTTPS reverse proxy (Caddy, Nginx, a load balancer)
TRUST_PROXY=false
PUBLIC_URL=http://localhost:3000

# ── PDF storage ──────────────────────────────────────────
# local = ./local-data/storage on this machine; s3 = any S3-compatible bucket
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for R2 / MinIO / Spaces
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── AI (optional) ────────────────────────────────────────
# Any OpenAI-compatible chat API that accepts PDF file input.
DISABLE_AI=true
# LLM_API_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_DEFAULT_MODEL=
